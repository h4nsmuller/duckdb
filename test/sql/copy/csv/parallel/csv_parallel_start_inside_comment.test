# name: test/sql/copy/csv/parallel/csv_parallel_start_inside_comment.test
# description: A parallel scan that starts inside a comment finds the row behind a comment that ends at a line break byte of another newline convention
# group: [parallel]

# a,b / 11,2 / #xx<CR>yy,z / 33,4 with line feeds: the comment ends at the carriage return, as it does with one buffer
statement ok
COPY (SELECT 'a,b' || chr(10) || '11,2' || chr(10) || '#xx' || chr(13) || 'yy,z' || chr(10) || '33,4') TO '{TEST_DIR}/comment_carriage_return.csv' (HEADER false, QUOTE '', DELIM '|');

query II
FROM read_csv('{TEST_DIR}/comment_carriage_return.csv', auto_detect = false, header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'}, new_line = '\n', comment = '#') ORDER BY ALL;
----
11	2
33	4
yy	z

loop buffer_size 8 31

query II
FROM read_csv('{TEST_DIR}/comment_carriage_return.csv', auto_detect = false, header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'}, new_line = '\n', comment = '#', buffer_size = {buffer_size}) ORDER BY ALL;
----
11	2
33	4
yy	z

endloop

# the same with \r\n line breaks and a comment that ends at a line feed
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || '11,2' || chr(13) || chr(10) || '#xx' || chr(10) || 'yy,z' || chr(13) || chr(10) || '33,4' || chr(13)) TO '{TEST_DIR}/comment_line_feed.csv' (HEADER false, QUOTE '', DELIM '|');

query II
FROM read_csv('{TEST_DIR}/comment_line_feed.csv', auto_detect = false, header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'}, new_line = '\r\n', comment = '#') ORDER BY ALL;
----
11	2
33	4
yy	z

foreach buffer_size 8 9 10 11 12 13 15 16 17 18 19 20 24 28 32 36 40

query II
FROM read_csv('{TEST_DIR}/comment_line_feed.csv', auto_detect = false, header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'}, new_line = '\r\n', comment = '#', buffer_size = {buffer_size}) ORDER BY ALL;
----
11	2
33	4
yy	z

endloop
