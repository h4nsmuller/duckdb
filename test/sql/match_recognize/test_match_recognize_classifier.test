# name: test/sql/match_recognize/test_match_recognize_classifier.test
# description: MATCH_RECOGNIZE classifiers, match numbering and ROWS PER MATCH
# group: [match_recognize]

statement ok
pragma threads=1;

statement ok
create table ev(i integer, v integer);

statement ok
insert into ev values (1,1),(2,0),(3,0),(4,1),(5,0),(6,1);

# PATTERN (A B+) finds 0-2 and 3-4; row 6 starts no match because no B follows it.
# ALL ROWS PER MATCH reports every row of every match, tagged with the variable that matched it.
query IIIIII
SELECT i, cl, mn, x = ms, ms, me
FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x, CLASSIFIER() AS cl, MATCH_NUMBER() AS mn,
             FINAL FIRST(i) AS ms, FINAL LAST(i) AS me
    ALL ROWS PER MATCH PATTERN (A B+) DEFINE A as v=1, B as v=0
) ORDER BY x
----
1	A	1	1	1	3
2	B	1	0	1	3
3	B	1	0	1	3
4	A	2	1	4	5
5	B	2	0	4	5

# ONE ROW PER MATCH reports only the row each match starts on
query III
SELECT x, cl, mn
FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x, CLASSIFIER() AS cl, MATCH_NUMBER() AS mn
    ONE ROW PER MATCH PATTERN (A B+) DEFINE A as v=1, B as v=0
) ORDER BY x
----
3	B	1
5	B	2

# the default is ONE ROW PER MATCH
query I
SELECT x FROM ev MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x PATTERN (A B+) DEFINE A as v=1, B as v=0
) ORDER BY x
----
3
5

statement ok
create table alt(i integer, v integer);

statement ok
insert into alt values (1,1),(2,0),(3,1);

# the classifier names the alternative that matched
query II
SELECT i, cl FROM alt MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x, CLASSIFIER() AS cl ALL ROWS PER MATCH PATTERN (A | B) DEFINE A as v=1, B as v=0
) ORDER BY x
----
1	A
2	B
3	A

statement ok
create table im(i integer);

statement ok
insert into im values (1),(2);

# a symbol that is used but not defined still classifies its row
query II
SELECT i, cl FROM im MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x, CLASSIFIER() AS cl ALL ROWS PER MATCH PATTERN (A Z) DEFINE A as true
) ORDER BY x
----
1	A
2	Z

statement ok
create table pv(p integer, i integer);

statement ok
insert into pv values (1,1),(1,2),(1,3),(1,4),(2,1),(2,2);

# match numbering restarts in every partition
query IIII
SELECT p, i, cl, mn FROM pv MATCH_RECOGNIZE(
    PARTITION BY p ORDER BY i MEASURES i AS x, CLASSIFIER() AS cl, MATCH_NUMBER() AS mn
    ALL ROWS PER MATCH PATTERN (A B) DEFINE A as true, B as true
) ORDER BY p, i
----
1	1	A	1
1	2	B	1
1	3	A	2
1	4	B	2
2	1	A	1
2	2	B	1

statement ok
create table rb(i integer);

statement ok
insert into rb values (1),(2),(3),(4),(5),(6);

# with a repeated variable, SKIP TO FIRST and SKIP TO LAST resume at different rows.
# PATTERN (A B B) matches [p, p+2] and classifies p+1 and p+2 as B.
query I
SELECT x FROM rb MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ONE ROW PER MATCH AFTER MATCH SKIP TO FIRST B PATTERN (A B B)
    DEFINE A as true, B as true
) ORDER BY x
----
3
4
5
6

query I
SELECT x FROM rb MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ONE ROW PER MATCH AFTER MATCH SKIP TO LAST B PATTERN (A B B)
    DEFINE A as true, B as true
) ORDER BY x
----
3
5

# SKIP PAST LAST ROW resumes after the whole match, SKIP TO NEXT ROW resumes one row in
query I
SELECT x FROM rb MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ONE ROW PER MATCH AFTER MATCH SKIP PAST LAST ROW PATTERN (A B B)
    DEFINE A as true, B as true
) ORDER BY x
----
3
6

query I
SELECT x FROM rb MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ONE ROW PER MATCH AFTER MATCH SKIP TO NEXT ROW PATTERN (A B B)
    DEFINE A as true, B as true
) ORDER BY x
----
3
4
5
6

# a quantifier may not give up a repetition it needs: (A B C) cannot match the final two rows
query I
SELECT count(*) FROM rb MATCH_RECOGNIZE(
    ORDER BY i MEASURES i AS x ONE ROW PER MATCH AFTER MATCH SKIP TO NEXT ROW PATTERN (A B C)
    DEFINE A as true, B as true, C as true
)
----
4

# CLASSIFIER(V) reads the classifier the way V.c reads a column: off the last row V matched, which
# for a SUBSET is the last row any of its members matched. Rows the variable never matched keep
# reading the last one it did, and read NULL until it has matched at all.

statement ok
create table cls_arg(i integer, c varchar);

statement ok
insert into cls_arg values (1,'a'),(2,'b'),(3,'x'),(4,'a');

query III
SELECT i, plain, scoped FROM cls_arg MATCH_RECOGNIZE(
    ORDER BY i MEASURES CLASSIFIER() AS plain, CLASSIFIER(U) AS scoped
    ALL ROWS PER MATCH PATTERN (A B C A) SUBSET U = (A, B)
    DEFINE A AS c = 'a', B AS c = 'b', C AS c = 'x'
) ORDER BY i
----
1	A	A
2	B	B
3	C	B
4	A	A

# naming one variable rather than a SUBSET reads only that variable's rows
query II
SELECT i, scoped FROM cls_arg MATCH_RECOGNIZE(
    ORDER BY i MEASURES CLASSIFIER(B) AS scoped
    ALL ROWS PER MATCH PATTERN (A B C A) SUBSET U = (A, B)
    DEFINE A AS c = 'a', B AS c = 'b', C AS c = 'x'
) ORDER BY i
----
1	NULL
2	B
3	B
4	B

# ONE ROW PER MATCH reports the finished match, so it reads the last row of the variable
query II
SELECT u, b FROM cls_arg MATCH_RECOGNIZE(
    ORDER BY i MEASURES CLASSIFIER(U) AS u, CLASSIFIER(B) AS b
    ONE ROW PER MATCH PATTERN (A B C A) SUBSET U = (A, B)
    DEFINE A AS c = 'a', B AS c = 'b', C AS c = 'x'
)
----
A	B

# the argument is a pattern variable of this clause, and nothing else stands there
statement error
SELECT x FROM cls_arg MATCH_RECOGNIZE(
    ORDER BY i MEASURES CLASSIFIER(c) AS x ONE ROW PER MATCH PATTERN (A) DEFINE A AS c = 'a'
)
----
<REGEX>:.*CLASSIFIER\(\) takes no arguments, or one pattern variable.*

statement error
SELECT x FROM cls_arg MATCH_RECOGNIZE(
    ORDER BY i MEASURES CLASSIFIER(A, A) AS x ONE ROW PER MATCH PATTERN (A) DEFINE A AS c = 'a'
)
----
<REGEX>:.*CLASSIFIER\(\) takes no arguments, or one pattern variable.*

# a condition is settled on the row being tested, so there is no other variable's row to read yet
statement error
SELECT n FROM cls_arg MATCH_RECOGNIZE(
    ORDER BY i MEASURES count(*) AS n ONE ROW PER MATCH PATTERN (A+)
    DEFINE A AS CLASSIFIER(A) = 'A'
)
----
<REGEX>:.*only supported in MEASURES, not in DEFINE.*

# collecting the classifiers of a match reports the shape it took without reporting its rows
query I
SELECT ca FROM (VALUES (1,120),(2,90),(3,150),(4,80),(5,200)) t(rn, price) MATCH_RECOGNIZE(
    ORDER BY rn MEASURES array_agg(CLASSIFIER() ORDER BY rn) AS ca
    ONE ROW PER MATCH PATTERN ((A | B)+) DEFINE A AS price > 100, B AS price <= 100
)
----
[A, B, A, B, A]
