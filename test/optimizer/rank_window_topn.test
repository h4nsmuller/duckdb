# 6. other predicates stay in the filter, even ones that reference the rank
query IIII nosort r06
SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 3 AND v > rk ORDER BY ALL
----

# 7. rk = 2: the pre-filter keeps a superset, the kept filter is exact
query IIII nosort
SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk = 2 ORDER BY ALL
----
2	20	2	2
2	20	3	2
2	20	4	2
3	NULL	2	2
3	NULL	3	2
4	8	2	2
NULL	2	2	2
NULL	2	3	2

# the constant on the left
query IIII
SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE 2 = rk ORDER BY ALL
----
2	20	2	2
2	20	3	2
2	20	4	2
3	NULL	2	2
3	NULL	3	2
4	8	2	2
NULL	2	2	2
NULL	2	3	2

# 8. the NULL partition key is a partition of its own
query III nosort
SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2 AND p IS NULL ORDER BY ALL
----
NULL	1	1
NULL	2	2
NULL	2	3

# 9. NULL order keys with NULLS LAST: kept in p = 3 (fewer than k non-NULL keys), dropped in p = 1
query III nosort
SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2 AND p IN (1, 3) ORDER BY ALL
----
1	1	1
1	1	2
3	5	1
3	NULL	2
3	NULL	3

