# name: test/optimizer/rank_window_topn.test
# description: rank() / dense_rank() <= k over a window partition: a per-partition threshold filter below the window
# group: [optimizer]

statement ok
CREATE TABLE t(p INTEGER, o INTEGER, o2 VARCHAR, v INTEGER);

# partitions 1..4 and a NULL partition; ties at every boundary; NULL keys in p = 1 and p = 3; p = 4 has two rows
statement ok
INSERT INTO t VALUES
	(1, 1, 'a', 1), (1, 1, 'b', 2), (1, 2, 'c', 3), (1, 3, 'd', 4), (1, 3, 'e', 5), (1, 4, 'f', 6), (1, NULL, 'g', 7),
	(2, 10, 'a', 1), (2, 20, 'b', 2), (2, 20, 'c', 3), (2, 20, 'd', 4), (2, 30, 'e', 5),
	(3, 5, 'x', 1), (3, NULL, 'y', 2), (3, NULL, 'z', 3),
	(4, 7, 'q', 1), (4, 8, 'r', 2),
	(NULL, 1, 'n', 1), (NULL, 2, 'n', 2), (NULL, 2, 'n', 3), (NULL, 3, 'n', 4);

# filler partitions (p >= 100, 20 rows each) so that the table statistics let the rule fire for k <= 3 (the guard
# skips a rewrite whose k keys per partition would cover most of the scanned rows); the queries filter them out below
# the window
statement ok
INSERT INTO t SELECT 100 + i % 100, i, 'z', i FROM range(2000) r(i);

statement ok
CREATE TABLE s(p INTEGER, w INTEGER);

statement ok
INSERT INTO s VALUES (1, 100), (1, 200), (2, 300), (3, 400), (4, 500), (NULL, 600);

# every query runs with the rule disabled and enabled (the foreach): the rows are the hand-checked result of the unmodified plan,
# which the rewritten plan must reproduce; a block without rows compares the two runs through its label

foreach disabled 'rank_window_topn' ''

statement ok
SET disabled_optimizers = {disabled};

# 1. filter only, ties exactly at position 3 (both tied rows of p = 2 at rank 2 stay, the rank-3 row of p = 1 too)
query III nosort
SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 3 ORDER BY ALL
----
1	1	1
1	1	2
1	2	3
2	10	1
2	20	2
2	20	3
2	20	4
3	5	1
3	NULL	2
3	NULL	3
4	7	1
4	8	2
NULL	1	1
NULL	2	2
NULL	2	3

# 2. the rank projected: gaps after ties stay
query IIII nosort
SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 3 ORDER BY ALL
----
1	1	1	1
1	1	2	1
1	2	3	3
2	10	1	1
2	20	2	2
2	20	3	2
2	20	4	2
3	5	1	1
3	NULL	2	2
3	NULL	3	2
4	7	1	1
4	8	2	2
NULL	1	1	1
NULL	2	2	2
NULL	2	3	2

# 3. rk < 4 is case 1
query III nosort
SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk < 4 ORDER BY ALL
----
1	1	1
1	1	2
1	2	3
2	10	1
2	20	2
2	20	3
2	20	4
3	5	1
3	NULL	2
3	NULL	3
4	7	1
4	8	2
NULL	1	1
NULL	2	2
NULL	2	3

# 4. rk = 1 with a tie for first place
query III nosort
SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk = 1 ORDER BY ALL
----
1	1	1
1	1	2
2	10	1
3	5	1
4	7	1
NULL	1	1

# 5. BETWEEN
query III nosort
SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk BETWEEN 1 AND 3 ORDER BY ALL
----
