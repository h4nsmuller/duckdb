SELECT p, o, v, rk FROM (SELECT *, dense_rank() OVER (PARTITION BY p % 3, o2 > 'c' ORDER BY o DESC) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2 ORDER BY ALL
