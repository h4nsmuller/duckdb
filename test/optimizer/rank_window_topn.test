# 12. two ORDER BY columns with mixed directions (sort-key mode), ties on o only
query IIII nosort r12
SELECT p, o, o2, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o, o2 DESC) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2 ORDER BY ALL
----

# ASC NULLS FIRST on one column
query IIII nosort r12b
SELECT p, o, o2, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o NULLS FIRST) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2 ORDER BY ALL
----

# 13. partitions smaller than k keep every row
query III nosort r13
SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 10 ORDER BY ALL
----

# 14. k = 1 without a partition (cross product path)
query III nosort
SELECT p, o, v FROM (SELECT *, rank() OVER (ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk = 1 ORDER BY ALL
----
1	1	1
1	1	2
NULL	1	1

# 15. one partition, k far above the row count
query III nosort r15
SELECT p, o, v FROM (SELECT *, rank() OVER (ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 100 ORDER BY ALL
----

# 16. dense_rank: both keys of p = 2 at dense ranks 1 and 2 (four rows), p = 1 keeps 1, 1, 2
query IIII nosort
SELECT p, o, v, rk FROM (SELECT *, dense_rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2 ORDER BY ALL
----
1	1	1	1
1	1	2	1
1	2	3	2
2	10	1	1
2	20	2	2
2	20	3	2
2	20	4	2
3	5	1	1
3	NULL	2	2
3	NULL	3	2
4	7	1	1
4	8	2	2
NULL	1	1	1
NULL	2	2	2
NULL	2	3	2

# 17. dense_rank with NULL keys first and DESC
query IIII nosort r17
SELECT p, o, v, rk FROM (SELECT *, dense_rank() OVER (PARTITION BY p ORDER BY o DESC NULLS FIRST) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2 ORDER BY ALL
----

query IIII nosort r17b
SELECT p, o, v, rk FROM (SELECT *, dense_rank() OVER (PARTITION BY p ORDER BY o DESC) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk < 3 ORDER BY ALL
----

# 18. VARCHAR and DECIMAL keys
query IIII nosort r18
SELECT p, o2, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o2) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2 ORDER BY ALL
----

query IIII nosort r18b
SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o::DECIMAL(10,2) DESC) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2 ORDER BY ALL
----

# 19. inputs that are materialized once: an aggregate and a join
query IIII nosort r19
SELECT p, o, c, rk FROM (SELECT p, o, count(*) c, rank() OVER (PARTITION BY p ORDER BY count(*) DESC) rk FROM t GROUP BY p, o) WHERE rk <= 1 ORDER BY ALL
----

query IIII nosort r19b
SELECT p, o, w, rk FROM (SELECT t.p, t.o, s.w, dense_rank() OVER (PARTITION BY t.p ORDER BY s.w, t.o) rk FROM t JOIN s ON t.p IS NOT DISTINCT FROM s.p) WHERE rk <= 2 ORDER BY ALL
----

# 20. the negative cases: a frame clause, >=, a non-constant k, k out of range, a sibling window function, row_number
query IIII nosort r20a
SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2 ORDER BY ALL
----

query IIII nosort r20b
SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk >= 3 ORDER BY ALL
----

query IIII nosort r20c
SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= p ORDER BY ALL
----

query IIII nosort r20d
SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 0 ORDER BY ALL
----

query IIII nosort r20e
SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2000000 ORDER BY ALL
----

query IIIII nosort r20f
SELECT p, o, v, rk, c FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk, count(*) OVER (PARTITION BY p ORDER BY o) c FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2 ORDER BY ALL
----

query IIII nosort r20g
SELECT p, o, v, rn FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY o, v) rn FROM t WHERE p < 10 OR p IS NULL) WHERE rn <= 2 ORDER BY ALL
----

endloop

# the plans
statement ok
SET disabled_optimizers = '';

# the plans: the threshold projection (__rank_topn_threshold) and the join below the window mark a fired rewrite

query II
EXPLAIN SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 3
----
physical_plan	<REGEX>:.*IS NOT DISTINCT FROM.*__rank_topn_threshold.*min\(.*

# DESC takes max and >=
query II
EXPLAIN SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o DESC) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 3
----
physical_plan	<REGEX>:.*__rank_topn_threshold.*max\(.*

# several orderings take the sort key
query II
EXPLAIN SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o, o2 DESC) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 3
----
physical_plan	<REGEX>:.*__rank_topn_threshold.*create_sort_key.*

# no partition: a cross product
query II
EXPLAIN SELECT p, o, v FROM (SELECT *, rank() OVER (ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 3
----
physical_plan	<REGEX>:.*Cross Product.*__rank_topn_threshold.*

# an aggregate input is materialized once
query II
EXPLAIN SELECT p, o, c, rk FROM (SELECT p, o, count(*) c, rank() OVER (PARTITION BY p ORDER BY count(*) DESC) rk FROM t GROUP BY p, o) WHERE rk <= 1
----
physical_plan	<REGEX>:.*__rank_topn_cte_.*__rank_topn_threshold.*

# the negatives leave the plan alone

query II
EXPLAIN SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

query II
EXPLAIN SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk >= 3
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

query II
EXPLAIN SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= p
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

query II
EXPLAIN SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 0
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

query II
EXPLAIN SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2000000
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

query II
EXPLAIN SELECT p, o, v, rk, c FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk, count(*) OVER (PARTITION BY p ORDER BY o) c FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

# row_number() belongs to top_n_window_elimination
query II
EXPLAIN SELECT p, o, v, rn FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY o, v) rn FROM t WHERE p < 10 OR p IS NULL) WHERE rn <= 2
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

# a pre-filter that cannot remove anything is not built: every partition is one row when the input is an aggregate
# whose group keys are all partition keys ...
query II
EXPLAIN SELECT p, c, rk FROM (SELECT p, count(*) c, rank() OVER (PARTITION BY p ORDER BY count(*) DESC) rk FROM t GROUP BY p) WHERE rk <= 5
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

query III
SELECT p, c, rk FROM (SELECT p, count(*) c, rank() OVER (PARTITION BY p ORDER BY count(*) DESC) rk FROM t WHERE p < 10 OR p IS NULL GROUP BY p) WHERE rk <= 5 ORDER BY ALL
----
1	7	1
2	5	1
3	3	1
4	2	1
NULL	4	1

# ... and the table statistics say so when k keys per partition cover most of the scanned rows
statement ok
CREATE TABLE u AS SELECT range AS p, range AS o FROM range(1000);

query II
EXPLAIN SELECT p, o FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM u) WHERE rk <= 3
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

query I
SELECT count(*) FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM u) WHERE rk <= 3
----
1000

# 21 partitions of 48 rows: k = 3 keys per partition is a small part of the input
statement ok
CREATE TABLE u2 AS SELECT range % 21 AS p, range AS o FROM range(1008);

query II
EXPLAIN SELECT p, o FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM u2) WHERE rk <= 3
----
physical_plan	<REGEX>:.*__rank_topn_threshold.*

query I
SELECT count(*) FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM u2) WHERE rk <= 3
----
63

# the guard also covers inputs without a scan at the bottom (CTE mode), from the estimates below the input: an
# aggregate input whose partition key has as many distinct values as the aggregate has rows ...
statement ok
CREATE TABLE ua AS SELECT range AS p, range % 10 AS o FROM range(1000);

query II
EXPLAIN SELECT p, o, c FROM (SELECT p, o, count(*) c, rank() OVER (PARTITION BY p ORDER BY c DESC) rk FROM ua GROUP BY p, o) WHERE rk <= 3
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

query I
SELECT count(*) FROM (SELECT p, o, count(*) c, rank() OVER (PARTITION BY p ORDER BY c DESC) rk FROM ua GROUP BY p, o) WHERE rk <= 3
----
1000

# ... and a join input whose partition key is as distinct as the rows
query II
EXPLAIN SELECT p, o FROM (SELECT ua.p, ua.o, rank() OVER (PARTITION BY ua.p ORDER BY u2.o) rk FROM ua JOIN u2 ON ua.o = u2.p) WHERE rk <= 3
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

# while 21 partitions of 48 groups each let the rewrite fire in CTE mode
statement ok
CREATE TABLE ub AS SELECT range % 21 AS p, range AS o FROM range(1008);

query II
EXPLAIN SELECT p, o, c FROM (SELECT p, o, count(*) c, rank() OVER (PARTITION BY p ORDER BY c DESC, o) rk FROM ub GROUP BY p, o) WHERE rk <= 3
----
physical_plan	<REGEX>:.*__rank_topn_cte_.*__rank_topn_threshold.*

query I
SELECT count(*) FROM (SELECT p, o, count(*) c, rank() OVER (PARTITION BY p ORDER BY c DESC, o) rk FROM ub GROUP BY p, o) WHERE rk <= 3
----
63

# an OR of rank predicates over two rankings of one window: one aggregate with a threshold per ranking, fired only
# when nothing but the filter reads the ranks (a removed row can lower the rank a survivor has in the other ranking)
query II
EXPLAIN SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk1, rank() OVER (PARTITION BY p ORDER BY o2 DESC) rk2 FROM t WHERE p < 10 OR p IS NULL) WHERE rk1 <= 2 OR rk2 <= 2
----
physical_plan	<REGEX>:.*__rank_topn_threshold.*__rank_topn_threshold.*

# the ranks projected: no rewrite
query II
EXPLAIN SELECT p, o, v, rk1, rk2 FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk1, rank() OVER (PARTITION BY p ORDER BY o2 DESC) rk2 FROM t WHERE p < 10 OR p IS NULL) WHERE rk1 <= 2 OR rk2 <= 2
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

# one rank projected, the other only filtered: still no rewrite
query II
EXPLAIN SELECT p, o, v, rk2 FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk1, rank() OVER (PARTITION BY p ORDER BY o2 DESC) rk2 FROM t WHERE p < 10 OR p IS NULL) WHERE rk1 <= 2 OR rk2 <= 2
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

# a rank read by the ORDER BY: no rewrite
query II
EXPLAIN SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk1, rank() OVER (PARTITION BY p ORDER BY o2 DESC) rk2 FROM t WHERE p < 10 OR p IS NULL) WHERE rk1 <= 2 OR rk2 <= 2 ORDER BY rk2
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

# rankings with different partitions: no rewrite
query II
EXPLAIN SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk1, rank() OVER (ORDER BY o2 DESC) rk2 FROM t WHERE p < 10 OR p IS NULL) WHERE rk1 <= 2 OR rk2 <= 2
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

# a partition expression: the aggregate groups by it, the join compares it with the group
query II
EXPLAIN SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p % 3 ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2
----
physical_plan	<REGEX>:.*IS NOT DISTINCT FROM.*__rank_topn_threshold.*

# the OR and the expression partition return the same rows with the rule disabled and enabled

foreach disabled 'rank_window_topn' ''

