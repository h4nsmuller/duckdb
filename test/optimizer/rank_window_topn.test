query IIII nosort
SELECT p, o, v, rk FROM (SELECT *, rank() OVER (PARTITION BY p % 3 ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 2 ORDER BY ALL
