SELECT p, o, v, rk2 FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk1, rank() OVER (PARTITION BY p ORDER BY o2 DESC) rk2 FROM t WHERE p < 10 OR p IS NULL) WHERE rk1 <= 2 OR rk2 <= 2 ORDER BY ALL
----

query IIII nosort r22c
SELECT p, o, v, rk FROM (SELECT *, dense_rank() OVER (PARTITION BY p ORDER BY o) rk1, rank() OVER (PARTITION BY p ORDER BY o2 DESC) rk2, 1 rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk1 = 1 OR rk2 < 3 ORDER BY ALL
