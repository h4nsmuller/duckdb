endloop

# an OR of rankings whose ranks reach the output: through a pass-through root (ORDER BY, LIMIT), a further projection,
# an alias, a CTE or an aggregate. The plan's output reads them, so there is no rewrite and the survivors keep the
# ranks of the whole input (a pre-filter would recompute every ranking on the survivors: rb = 6, 5, 4 instead of
# 100, 99, 98 for the first three rows)

statement ok
CREATE TABLE r AS SELECT i AS a, 100 - i AS b, (100 - i) // 10 AS b2 FROM range(1, 101) t(i);

foreach disabled 'rank_window_topn' ''

statement ok
SET disabled_optimizers = {disabled};

# two rank() with different ORDER BYs, both projected, sorted by a plain column (the SQLStorm shape)
query IIII nosort
SELECT a, b, ra, rb FROM (SELECT a, b, rank() OVER (ORDER BY a) ra, rank() OVER (ORDER BY b) rb FROM r) WHERE ra <= 3 OR rb <= 3 ORDER BY a
----
1	99	1	100
2	98	2	99
3	97	3	98
98	2	98	3
99	1	99	2
100	0	100	1

# a LIMIT at the root
query IIII nosort
SELECT a, b, ra, rb FROM (SELECT a, b, rank() OVER (ORDER BY a) ra, rank() OVER (ORDER BY b) rb FROM r) WHERE ra <= 3 OR rb <= 3 ORDER BY a LIMIT 4
----
1	99	1	100
2	98	2	99
3	97	3	98
98	2	98	3

# one rank read above under an alias in a further projection
query III nosort
SELECT a, b, x FROM (SELECT a, b, rb AS x FROM (SELECT a, b, rank() OVER (ORDER BY a) ra, rank() OVER (ORDER BY b) rb FROM r) WHERE ra <= 3 OR rb <= 3) ORDER BY a
----
1	99	100
2	98	99
3	97	98
98	2	3
99	1	2
100	0	1

# through CTEs
query IIII nosort
WITH ranked AS (SELECT a, b, rank() OVER (ORDER BY a) ra, rank() OVER (ORDER BY b) rb FROM r), top AS (SELECT * FROM ranked WHERE ra <= 3 OR rb <= 3) SELECT a, b, ra, rb FROM top ORDER BY a
----
1	99	1	100
2	98	2	99
3	97	3	98
98	2	98	3
99	1	99	2
100	0	100	1

# an aggregate over the ranks
query II
SELECT sum(ra), sum(rb) FROM (SELECT a, b, rank() OVER (ORDER BY a) ra, rank() OVER (ORDER BY b) rb FROM r) WHERE ra <= 3 OR rb <= 3
----
303	303

# rank() and dense_rank() of one node, both projected
query III nosort
SELECT a, ra, dr FROM (SELECT a, rank() OVER (ORDER BY a) ra, dense_rank() OVER (ORDER BY b2) dr FROM r) WHERE ra <= 2 OR dr <= 1 ORDER BY a
----
1	1	10
2	2	10
91	91	1
92	92	1
93	93	1
94	94	1
95	95	1
96	96	1
97	97	1
98	98	1
99	99	1
100	100	1

# a row_number() beside the rank: the C++ rule's function, never matched
query III nosort
SELECT a, ra, rn FROM (SELECT a, rank() OVER (ORDER BY a) ra, row_number() OVER (ORDER BY b) rn FROM r) WHERE ra <= 2 OR rn <= 2 ORDER BY a
----
1	1	100
2	2	99
99	99	2
100	100	1

# a second function of a matched ranking on the node, read above: its values would change for the rows the other
# ranking keeps
query II rowsort
SELECT a, ra2 FROM (SELECT a, rank() OVER (ORDER BY a) ra, rank() OVER (ORDER BY a) ra2, rank() OVER (ORDER BY b) rb FROM r) WHERE ra <= 3 OR rb <= 3
----
1	1
100	100
2	2
3	3
98	98
99	99

# the ranks only filtered: the rewrite fires under any root
query II nosort
SELECT a, b FROM (SELECT a, b, rank() OVER (ORDER BY a) ra, rank() OVER (ORDER BY b) rb FROM r) WHERE ra <= 3 OR rb <= 3 ORDER BY a
----
1	99
2	98
3	97
98	2
99	1
100	0

endloop

statement ok
SET disabled_optimizers = '';

# the plans: the ranks reach the output through the ORDER BY root, through the LIMIT, through the CTEs
query II
EXPLAIN SELECT a, b, ra, rb FROM (SELECT a, b, rank() OVER (ORDER BY a) ra, rank() OVER (ORDER BY b) rb FROM r) WHERE ra <= 3 OR rb <= 3 ORDER BY a
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

query II
EXPLAIN SELECT a, b, ra, rb FROM (SELECT a, b, rank() OVER (ORDER BY a) ra, rank() OVER (ORDER BY b) rb FROM r) WHERE ra <= 3 OR rb <= 3 LIMIT 4
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

query II
EXPLAIN WITH ranked AS (SELECT a, b, rank() OVER (ORDER BY a) ra, rank() OVER (ORDER BY b) rb FROM r), top AS (SELECT * FROM ranked WHERE ra <= 3 OR rb <= 3) SELECT a, b, ra, rb FROM top ORDER BY a
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

# a duplicate of a matched ranking on the node, read above
query II
EXPLAIN SELECT a, ra2 FROM (SELECT a, rank() OVER (ORDER BY a) ra, rank() OVER (ORDER BY a) ra2, rank() OVER (ORDER BY b) rb FROM r) WHERE ra <= 3 OR rb <= 3
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

# the ranks only filtered: two thresholds under the ORDER BY root
query II
EXPLAIN SELECT a, b FROM (SELECT a, b, rank() OVER (ORDER BY a) ra, rank() OVER (ORDER BY b) rb FROM r) WHERE ra <= 3 OR rb <= 3 ORDER BY a
----
physical_plan	<REGEX>:.*__rank_topn_threshold.*__rank_topn_threshold.*

statement ok
SET disabled_optimizers = '';

# the rule has its own disabled_optimizers name
statement ok
SET disabled_optimizers = 'rank_window_topn';

query II
EXPLAIN SELECT p, o, v FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY o) rk FROM t WHERE p < 10 OR p IS NULL) WHERE rk <= 3
----
physical_plan	<!REGEX>:.*__rank_topn_threshold.*

statement ok
SET disabled_optimizers = '';
