# QUALIFY
query II
EXPLAIN SELECT p, i, a, b FROM t QUALIFY row_number() OVER (PARTITION BY p ORDER BY b DESC, a DESC, i DESC) = 1 ORDER BY p;
----
logical_opt	<!REGEX>:.*Window.*

