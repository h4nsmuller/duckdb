# over a join
query II
EXPLAIN SELECT p, i, j FROM (SELECT t.p, t.i, u.i AS j, row_number() OVER (PARTITION BY t.p ORDER BY u.a DESC, t.i, u.i) rn FROM t JOIN t u ON t.i = u.i + 50) WHERE rn = 1 ORDER BY p;
----
logical_opt	<!REGEX>:.*Window.*

query III
SELECT p, i, j FROM (SELECT t.p, t.i, u.i AS j, row_number() OVER (PARTITION BY t.p ORDER BY u.a DESC, t.i, u.i) rn FROM t JOIN t u ON t.i = u.i + 50) WHERE rn = 1 ORDER BY p;
----
0	77	27
1	57	7
2	93	43
3	73	23
4	53	3
5	61	11
6	69	19

# rank() keeps ties: not rewritten
query II
EXPLAIN SELECT p, i FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY a, b) rn FROM t WHERE i < 60) WHERE rn = 1 ORDER BY p, i;
----
logical_opt	<REGEX>:.*Window.*

query II
SELECT p, i FROM (SELECT *, rank() OVER (PARTITION BY p ORDER BY a, b) rn FROM t WHERE i < 60) WHERE rn = 1 ORDER BY p, i;
----
0	28
1	8
2	44
3	52
4	4
5	12
6	48

# dense_rank() keeps ties: not rewritten
query II
EXPLAIN SELECT p, i FROM (SELECT *, dense_rank() OVER (PARTITION BY p ORDER BY a, b) rn FROM t WHERE p < 2 AND i < 60) WHERE rn <= 2 ORDER BY p, i;
----
logical_opt	<REGEX>:.*Window.*

query II
SELECT p, i FROM (SELECT *, dense_rank() OVER (PARTITION BY p ORDER BY a, b) rn FROM t WHERE p < 2 AND i < 60) WHERE rn <= 2 ORDER BY p, i;
----
0	28
0	56
1	8
1	36

