# the top 3 of single-row partitions: the heaps would hold the whole input, the window stays
query II
EXPLAIN SELECT i, s, rn FROM (SELECT i, s, row_number() OVER (PARTITION BY i ORDER BY a, s) rn FROM t WHERE i < 5) WHERE rn <= 3 ORDER BY i;
----
logical_opt	<REGEX>:.*Window.*

