# the top 2 of 1000 partitions: the heaps stay small
query II
EXPLAIN SELECT q, i, rn FROM (SELECT q, i, row_number() OVER (PARTITION BY q ORDER BY a, i) rn FROM t WHERE q < 3) WHERE rn <= 2 ORDER BY q, rn;
----
logical_opt	<!REGEX>:.*Window.*

query III
