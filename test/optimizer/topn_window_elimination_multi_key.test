# name: test/optimizer/topn_window_elimination_multi_key.test
# description: Top-N window elimination with several ORDER BY keys, mixed directions and NULL orders
# group: [optimizer]

statement ok
SET explain_output = OPTIMIZED_ONLY;

statement ok
CREATE TABLE t AS SELECT i, i % 7 AS p, i % 1000 AS q, CASE WHEN i % 5 = 0 THEN NULL ELSE i % 4 END AS a, CASE WHEN i % 3 = 0 THEN NULL ELSE (i * 37) % 11 END AS b, 'v' || i AS s FROM range(20000) r(i);

# several keys, same direction: NULL keys sort last per key
query II
EXPLAIN SELECT p, i, s FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY a, b, i) rn FROM t) WHERE rn = 1 ORDER BY p;
----
logical_opt	<!REGEX>:.*Window.*

query III
SELECT p, i, s FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY a, b, i) rn FROM t) WHERE rn = 1 ORDER BY p;
----
0	308	v308
1	176	v176
2	44	v44
3	836	v836
4	88	v88
5	572	v572
6	748	v748

# mixed directions
query II
EXPLAIN SELECT p, i, a, b FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY a DESC, b, i) rn FROM t) WHERE rn = 1 ORDER BY p;
----
logical_opt	<!REGEX>:.*Window.*

query IIII
SELECT p, i, a, b FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY a DESC, b, i) rn FROM t) WHERE rn = 1 ORDER BY p;
----
0	539	3	0
1	407	3	0
2	583	3	0
3	143	3	0
4	11	3	0
5	187	3	0
6	671	3	0

# all descending: a NULL key still sorts last, unlike in a descending row comparison
query II
EXPLAIN SELECT p, i, a, b FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY a DESC, b DESC, i DESC) rn FROM t) WHERE rn = 1 ORDER BY p;
----
logical_opt	<!REGEX>:.*Window.*

query IIII
SELECT p, i, a, b FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY a DESC, b DESC, i DESC) rn FROM t) WHERE rn = 1 ORDER BY p;
----
0	19159	3	10
1	19951	3	10
2	19819	3	10
3	19687	3	10
4	19247	3	10
5	19423	3	10
6	19907	3	10

# explicit NULL orders per key
query II
EXPLAIN SELECT p, i, a, b FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY a DESC NULLS FIRST, b ASC NULLS FIRST, i DESC) rn FROM t) WHERE rn = 1 ORDER BY p;
----
logical_opt	<!REGEX>:.*Window.*

query IIII
SELECT p, i, a, b FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY a DESC NULLS FIRST, b ASC NULLS FIRST, i DESC) rn FROM t) WHERE rn = 1 ORDER BY p;
----
0	19950	NULL	NULL
1	19965	NULL	NULL
2	19980	NULL	NULL
3	19995	NULL	NULL
4	19905	NULL	NULL
5	19920	NULL	NULL
6	19935	NULL	NULL

# top 3 with the row number in the result
query II
EXPLAIN SELECT p, i, a, b, rn FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY a NULLS FIRST, b DESC, i) rn FROM t WHERE p < 3) WHERE rn <= 3 ORDER BY p, rn;
----
logical_opt	<!REGEX>:.*Window.*

query IIIII
SELECT p, i, a, b, rn FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY a NULLS FIRST, b DESC, i) rn FROM t WHERE p < 3) WHERE rn <= 3 ORDER BY p, rn;
----
0	140	NULL	10	1
0	910	NULL	10	2
0	1295	NULL	10	3
1	85	NULL	10	1
1	470	NULL	10	2
1	1240	NULL	10	3
2	415	NULL	10	1
2	800	NULL	10	2
2	1570	NULL	10	3

# strict comparison
query II
EXPLAIN SELECT p, i, a, b, rn FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY a NULLS FIRST, b DESC, i) rn FROM t WHERE p < 3) WHERE rn < 3 ORDER BY p, rn;
----
logical_opt	<!REGEX>:.*Window.*

query IIIII
SELECT p, i, a, b, rn FROM (SELECT *, row_number() OVER (PARTITION BY p ORDER BY a NULLS FIRST, b DESC, i) rn FROM t WHERE p < 3) WHERE rn < 3 ORDER BY p, rn;
----
0	140	NULL	10	1
0	910	NULL	10	2
1	85	NULL	10	1
1	470	NULL	10	2
2	415	NULL	10	1
2	800	NULL	10	2

# a single NULLS FIRST key
query II
EXPLAIN SELECT p, i, n FROM (SELECT p, i, nullif(i, 9) AS n, row_number() OVER (PARTITION BY p ORDER BY nullif(i, 9) NULLS FIRST) rn FROM t WHERE i < 21) WHERE rn = 1 ORDER BY p;
----
logical_opt	<!REGEX>:.*Window.*

query III
SELECT p, i, n FROM (SELECT p, i, nullif(i, 9) AS n, row_number() OVER (PARTITION BY p ORDER BY nullif(i, 9) NULLS FIRST) rn FROM t WHERE i < 21) WHERE rn = 1 ORDER BY p;
----
0	0	0
1	1	1
2	9	NULL
3	3	3
4	4	4
5	5	5
6	6	6

