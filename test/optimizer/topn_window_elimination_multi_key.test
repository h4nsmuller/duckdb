# the first row of 1000 partitions
query II
EXPLAIN SELECT q, i FROM (SELECT q, i, row_number() OVER (PARTITION BY q ORDER BY a, i) rn FROM t WHERE q < 3) WHERE rn = 1 ORDER BY q;
----
logical_opt	<!REGEX>:.*Window.*

